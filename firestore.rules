rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    // Catálogo público de produtos (leitura liberada para autocompletar e conferência)
    match /produtos/{produtoId} {
      allow read: if true;
      allow write: if estaAutenticado();
    }

    // Listagem de condomínios e lojas ativas
    match /condominios/{condominioId} {
      allow read: if true;
      allow write: if estaAutenticado();
    }

    // Ocorrências com dados pessoais de moradores
    match /ocorrencias/{ocorrenciaId} {
      allow read, write: if true;
    }

    // Cadastro de moradores e contatos (WhatsApp / LGPD)
    match /pessoas/{pessoaId} {
      allow read, write: if true;
    }

    // Dias fechados e reposições operacionais
    match /dias_fechados/{diaId} {
      allow read, write: if true;
    }

    match /reposicoes/{reposicaoId} {
      allow read, write: if true;
    }

    match /furos_reposicao/{furoId} {
      allow read, write: if true;
    }

    // Configurações gerais do sistema e PIN de acesso
    match /configuracoes/{configId} {
      allow read, write: if estaAutenticado();
    }

    // Bloqueio padrão para qualquer outra coleção não mapeada
    match /{document=**} {
      allow read, write: if estaAutenticado();
    }
  }
}
